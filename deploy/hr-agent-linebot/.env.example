# 複製成 .env 後填值；.env 不進 git（chmod 600）。

# Gateway 驗證 token：openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Host 對外 port（容器內固定 18789）
GATEWAY_PORT=18796
# 官方 OpenClaw 原始碼路徑（build context，相對於本資料夾；目前 checkout v2026.8.1）
OPENCLAW_SRC=../../../openclaw

# LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 模型 API key（對應 openclaw.json 的 agents.defaults.model）
OPENROUTER_API_KEY=
OPENAI_API_KEY=
